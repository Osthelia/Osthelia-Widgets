# Rendered at container start (nginx-unprivileged envsubst): GCS_API_URL comes from the environment, so one image serves staging and production.
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Overrides the empty dist/config.js.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache";
        return 200 'window.__WIDGETS_CONFIG__ = { gcsApiUrl: "${GCS_API_URL}" };';
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Hashed files, safe to cache for good.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Widget routes (/head-to-head, /heatmap, /veto) fall back to the single page. Query strings are untouched.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
