# Base URL of the GC Stats site exposing /api/widgets/* (used by `npm run dev` and as a build-time fallback).
# In the Docker image, the GCS_API_URL environment variable of the container takes precedence at runtime.
VITE_GCS_API_URL=http://localhost:3000
# Optional: sub-path where the widgets are hosted (default "/"), e.g. /widgets/
# VITE_BASE=/
